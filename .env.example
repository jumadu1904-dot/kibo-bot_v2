TELEGRAM_TOKEN=
BOT_MODE=polling          # polling | webhook
PUBLIC_URL=               # e.g. http://localhost:8000 in local dev. Needed for
                          # Google OAuth redirects even in BOT_MODE=polling
                          # (FastAPI always serves HTTP); required for webhook mode too.
WEBHOOK_SECRET=
# Local dev default: SQLite, zero setup. In production use Neon (Postgres):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./kibo.db
CRON_SECRET=                # required by GET /check-reminders (?token=...)
GEMINI_API_KEY=
# Google Cloud Console (OAuth client, Web application type). Calendar API and
# Tasks API must be enabled, and PUBLIC_URL + /oauth/google/callback must be
# added to the client's Authorized redirect URIs (http://localhost:<port>/...
# is accepted by Google for local testing on a "Web application" client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key for encrypting stored Google refresh tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Any random long string — signs the OAuth `state` param. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SECRET=
